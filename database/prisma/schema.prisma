generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model TableEventRecord {
  id        String   @id
  tableId   String
  roundId   String?
  sequence  Int
  type      String
  payload   Json
  timestamp DateTime

  @@unique([tableId, sequence])
  @@index([tableId, timestamp])
}

model DealerFollow {
  id        String   @id @default(cuid())
  dealerId  String
  playerId  String
  createdAt DateTime @default(now())

  @@unique([dealerId, playerId])
}
