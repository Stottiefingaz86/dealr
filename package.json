{
  "name": "live-dealr",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev --filter=@live-dealr/api --filter=@live-dealr/player --filter=@live-dealr/dealer-console --filter=@live-dealr/admin",
    "dev:player": "turbo run dev --filter=@live-dealr/player",
    "dev:dealer": "turbo run dev --filter=@live-dealr/dealer-console",
    "dev:api": "turbo run dev --filter=@live-dealr/api",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "db:generate": "pnpm --filter @live-dealr/database generate",
    "db:migrate": "pnpm --filter @live-dealr/database migrate",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "prettier": "^3.6.2",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3"
  }
}
